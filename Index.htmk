<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Consulta de Rotas e Entregadores</title>
    <style>
        :root {
            --bg: #0f172a;
            --card: #1e293b;
            --primary: #3b82f6;
            --text: #f8fafc;
            --muted: #94a3b8;
            --border: #334155;
            --accent: #10b981;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: var(--bg); color: var(--text); display: flex; justify-content: center; min-height: 100vh; padding: 16px; }
        .container { width: 100%; max-width: 480px; }
        header { text-align: center; margin-bottom: 20px; padding-top: 10px; }
        header h1 { font-size: 1.4rem; font-weight: 700; color: var(--text); }
        header p { font-size: 0.85rem; color: var(--muted); margin-top: 4px; }
        .search-box { position: sticky; top: 10px; z-index: 10; background: var(--bg); padding-bottom: 12px; }
        input[type="text"] {
            width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border);
            background: var(--card); color: var(--text); font-size: 1rem; outline: none; transition: 0.2s;
        }
        input[type="text"]:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2); }
        .status { text-align: center; color: var(--muted); font-size: 0.9rem; margin-top: 30px; }
        .card {
            background: var(--card); border: 1px solid var(--border); border-radius: 12px;
            padding: 16px; margin-bottom: 12px; animation: fadeIn 0.2s ease;
        }
        .rua-title { font-size: 1.05rem; font-weight: 700; color: var(--primary); margin-bottom: 10px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
        .entregador-item { display: flex; flex-direction: column; padding: 8px 0; border-bottom: 1px dashed #2d3b4e; }
        .entregador-item:last-child { border-bottom: none; padding-bottom: 0; }
        .entregador-nome { font-weight: 600; font-size: 0.95rem; color: var(--text); display: flex; align-items: center; gap: 6px; }
        .badge { background: rgba(16, 185, 129, 0.15); color: var(--accent); font-size: 0.8rem; padding: 3px 8px; border-radius: 6px; margin-top: 4px; display: inline-block; width: fit-content; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Consulta de Entregadores</h1>
        <p>Digite o nome da rua para localizar a rota</p>
    </header>

    <div class="search-box">
        <input type="text" id="campoBusca" placeholder="Ex: Rua das Flores, Av. Brasil..." autocomplete="off">
    </div>

    <div id="resultados">
        <div class="status">Conectando ao banco de dados...</div>
    </div>
</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyC1hLk6k1E138ffdJT9oMBgRh6di4PR2EY",
        authDomain: "rota-entregadores.firebaseapp.com",
        databaseURL: "https://rota-entregadores-default-rtdb.firebaseio.com",
        projectId: "rota-entregadores",
        storageBucket: "rota-entregadores.firebasestorage.app",
        messagingSenderId: "1094577907467",
        appId: "1:1094577907467:web:8472471b28b1ffa459640e",
        measurementId: "G-V71JKBYEZY"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    let baseDados = [];

    function normalizar(texto) {
        return texto ? texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim() : "";
    }

    db.ref('rotas').on('value', (snapshot) => {
        baseDados = [];
        const data = snapshot.val();
        if (data) {
            Object.keys(data).forEach(id => {
                baseDados.push({ id, ...data[id] });
            });
        }
        filtrarRuas();
    }, (error) => {
        document.getElementById('resultados').innerHTML = `<div class="status" style="color:#ef4444;">Erro de permissão no Firebase: verifique as Regras do Realtime Database.</div>`;
    });

    const campoBusca = document.getElementById('campoBusca');
    const divResultados = document.getElementById('resultados');

    campoBusca.addEventListener('input', filtrarRuas);

    function filtrarRuas() {
        const termo = normalizar(campoBusca.value);

        if (baseDados.length === 0) {
            divResultados.innerHTML = '<div class="status">Nenhuma rua cadastrada no sistema.</div>';
            return;
        }

        if (termo.length < 2) {
            divResultados.innerHTML = '<div class="status">Digite pelo menos 2 letras do nome da rua...</div>';
            return;
        }

        const filtrados = baseDados.filter(item => normalizar(item.rua).includes(termo));

        if (filtrados.length === 0) {
            divResultados.innerHTML = '<div class="status">Nenhum entregador encontrado para esta rua.</div>';
            return;
        }

        const agrupadoPorRua = {};
        filtrados.forEach(item => {
            const chaveRua = normalizar(item.rua);
            if (!agrupadoPorRua[chaveRua]) {
                agrupadoPorRua[chaveRua] = {
                    nomeExibicao: item.rua,
                    entregadores: []
                };
            }
            agrupadoPorRua[chaveRua].entregadores.push({
                nome: item.entregador,
                numeracao: item.numeracao || "Toda a rua"
            });
        });

        let html = '';
        Object.values(agrupadoPorRua).forEach(grupo => {
            html += `<div class="card">
                        <div class="rua-title">${grupo.nomeExibicao}</div>`;
            
            grupo.entregadores.forEach(ent => {
                html += `<div class="entregador-item">
                            <span class="entregador-nome">🚚 ${ent.nome}</span>
                            <span class="badge">Numeração: ${ent.numeracao}</span>
                         </div>`;
            });

            html += `</div>`;
        });

        divResultados.innerHTML = html;
    }
</script>
</body>
</html>
